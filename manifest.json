{
  "manifest_version": 3,
  "name": "LinkedIn Comment Wingman",
  "version": "0.1.0",
  "description": "Generate high-quality comments using your ChatGPT session.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "windows",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "src/linkedin-injection.js",
        "src/linkedin-ui.js",
        "src/linkedin-results.js",
        "src/ui-symbols.js",
        "src/linkedin.js"
      ],
      "css": [
        "src/linkedin.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/chatgpt.js"
      ]
    }
  ],
  "action": {
    "default_title": "LinkedIn Comment Wingman",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
